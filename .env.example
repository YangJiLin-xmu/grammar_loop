# Local sample walkthrough works without any external service.
STORAGE_MODE=local
ENABLE_SAMPLE_MODE=true
LOCAL_DATA_DIR=.data

# Real image recognition, diagnosis and practice generation (server only).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Set STORAGE_MODE=supabase after creating a project and running db:migrate.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=grammar-loop

# Direct/session PostgreSQL connection for migration and pg-boss.
# Use the connection details from your Supabase project; include its SSL settings.
DATABASE_URL=

# Optional stable local session secret. Generated privately in .data if omitted.
SESSION_SECRET=
# Set to the exact public origin when running behind a reverse proxy.
APP_ORIGIN=
